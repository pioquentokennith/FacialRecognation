{
  "name": "presence-desktop",
  "version": "1.1.0",
  "private": true,
  "description": "Offline face-assisted classroom attendance for Windows",
  "author": "Presence Desktop",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron . --dev\"",
    "build": "node scripts/verify-backend.cjs && vite build",
    "start": "electron .",
    "test": "electron scripts/test-runner.cjs",
    "test:ui": "playwright test",
    "backend:setup": "node scripts/setup-backend.cjs",
    "test:vision": "backend\\runtime\\python.exe -B backend/test_vision.py",
    "postinstall": "node node_modules/electron/install.js && electron-builder install-app-deps",
    "pack": "npm run build && electron-builder --win --dir",
    "dist": "npm run build && electron-builder --win nsis",
    "smoke": "electron . --smoke-test"
  },
  "dependencies": {
    "better-sqlite3": "12.11.1",
    "lucide-react": "^0.468.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "^7.13.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.0",
    "electron": "42.11.18",
    "electron-builder": "26.18.0",
    "vite": "8.3.7",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.presence.attendance",
    "productName": "Presence Attendance",
    "directories": { "output": "release-v1.1" },
    "files": ["dist/**/*", "electron/**/*", "package.json", "README.md", "THIRD_PARTY_NOTICES.md"],
    "extraResources": [{ "from": "backend", "to": "vision-backend", "filter": ["**/*", "!**/__pycache__/**", "!**/tests/**", "!**/test/**", "!test_*.py", "!runtime/Lib/site-packages/pip/**", "!runtime/Scripts/**"] }],
    "asarUnpack": ["node_modules/better-sqlite3/**/*"],
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }], "icon": "build/icon.ico", "signExecutable": false },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
